# BlackBox Environment Configuration

# Environment Mode (production / development)
NODE_ENV=production

# Server Port (optional, defaults to 5000 locally)
PORT=5000

# MongoDB Connection String (Required in production - MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/blackbox?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret (Required for signing auth tokens)
JWT_SECRET=
